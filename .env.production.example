APP_NAME=Overshark
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-dominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

BCRYPT_ROUNDS=10

LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=overshark-cache-

# Correo de confirmación del pedido (sale por la cola: queue:work debe estar activo).
# Resend: crea la API key en resend.com y verifica el dominio (SPF/DKIM) para poder enviar desde él.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=pedidos@overshark.pe
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Sincronizacion de productos desde Zazu 2.
ZAZU_BASE_URL=
ZAZU_INVENTORY_PATH=/api/external/inventario
ZAZU_INVENTORY_TOKEN=
ZAZU_TIMEOUT=30
# Empresas de Zazu que vende la tienda (parte del nombre, separadas por coma).
ZAZU_COMPANIES=OVERSHARK,BRAVOS

# CRM-LIVEX-V2: cada pedido pagado se registra como venta (el CRM asigna la nota de venta NV, la envía
# a Zazu y al ERP y emite la boleta). Clave API del CRM con permiso sales.write (Integraciones).
CRM_SEND_SALES=false
CRM_BASE_URL=
CRM_API_KEY=
CRM_TIMEOUT=30

# Enlaces de las tarjetas "Compras en vivo" y "Asesoria personalizada" de la portada.
STOREFRONT_LIVE_URL=
STOREFRONT_CHAT_URL=
# Dirección y horario del almacén para "Recojo en almacén" (gratis). Vacío = se envía por WhatsApp.
STOREFRONT_PICKUP_ADDRESS=
# Costo de envío (S/): a domicilio en Lima y recojo en agencia Shalom. El recojo en almacén es gratis.
STOREFRONT_SHIPPING_HOME=15
STOREFRONT_SHIPPING_AGENCY=14
# Separo (S/) de los pedidos contraentrega; se paga en el checkout con tarjeta (Culqi) o Yape (Ligo Pay).
STOREFRONT_COD_DEPOSIT_HOME=15
STOREFRONT_COD_DEPOSIT_AGENCY=30

# Pagos con tarjeta (Culqi). Sin las dos llaves el formulario se ve pero no se puede pagar.
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=

# Modo simulación: tarjetas y QR de prueba sin cobrar, y nota de venta/ERP/boleta/correo simulados.
# Solo para desarrollo; en producción (APP_ENV=production) se ignora.
PAYMENTS_SIMULATE=false
PAYMENTS_QR_MINUTES=10

# Yape con QR de Ligo Pay (pendiente de su API; dejar en false hasta integrarlo).
LIGO_PAY_ENABLED=false
LIGO_PAY_BASE_URL=
LIGO_PAY_CLIENT_ID=
LIGO_PAY_CLIENT_SECRET=


# OBLIGATORIO: genera uno propio, p. ej.  php -r "echo bin2hex(random_bytes(32));"
# En producción el valor de ejemplo se rechaza y el acceso al panel queda bloqueado.
JWT_SECRET=change-me-to-a-random-32-character-minimum-secret
JWT_ISSUER="${APP_URL}"
JWT_TTL=60
JWT_COOKIE=overshark_admin_token
JWT_SECURE_COOKIE=true

