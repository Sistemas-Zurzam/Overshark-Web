APP_NAME=Overshark
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-dominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

BCRYPT_ROUNDS=10

LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=overshark-cache-

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=ventas@overshark.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Sincronizacion de productos desde Zazu 2.
ZAZU_BASE_URL=
ZAZU_INVENTORY_PATH=/api/external/inventario
ZAZU_INVENTORY_TOKEN=
ZAZU_TIMEOUT=30

JWT_SECRET=change-me-to-a-random-32-character-minimum-secret
JWT_ISSUER="${APP_URL}"
JWT_TTL=60
JWT_COOKIE=overshark_admin_token
JWT_SECURE_COOKIE=true
