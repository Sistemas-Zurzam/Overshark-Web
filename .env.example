APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log = el correo no se envía, solo se escribe en storage/logs (desarrollo). En producción: resend (RESEND_API_KEY).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=pedidos@overshark.pe
MAIL_FROM_NAME=resend
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_MAPS_API_KEY=

# Sincronizacion de productos activos desde Zazu 2.
# ZAZU_BASE_URL debe ser la URL raiz de Zazu, sin /api al final.
ZAZU_BASE_URL=
ZAZU_INVENTORY_PATH=/api/external/inventario
ZAZU_INVENTORY_TOKEN=
ZAZU_TIMEOUT=30
# Empresas de Zazu que vende la tienda (parte del nombre, separadas por coma).
ZAZU_COMPANIES=OVERSHARK,BRAVOS

# CRM-LIVEX-V2: cada pedido pagado se registra como venta (el CRM asigna la nota de venta NV, la envÃ­a
# a Zazu y al ERP y emite la boleta). Clave API del CRM con permiso sales.write (Integraciones).
CRM_SEND_SALES=false
CRM_BASE_URL=
CRM_API_KEY=
CRM_TIMEOUT=30

# Enlaces de las tarjetas "Compras en vivo" y "Asesoria personalizada" de la portada.
STOREFRONT_LIVE_URL=
STOREFRONT_CHAT_URL=
# DirecciÃ³n y horario del almacÃ©n para "Recojo en almacÃ©n" (gratis). VacÃ­o = se envÃ­a por WhatsApp.
STOREFRONT_PICKUP_ADDRESS=
# Costo de envÃ­o (S/): a domicilio en Lima y recojo en agencia Shalom. El recojo en almacÃ©n es gratis.
STOREFRONT_SHIPPING_HOME=15
STOREFRONT_SHIPPING_AGENCY=30
# Separo (S/) de los pedidos contraentrega; se paga en el checkout con tarjeta (Culqi) o Yape (Ligo Pay).
STOREFRONT_COD_DEPOSIT_HOME=15
STOREFRONT_COD_DEPOSIT_AGENCY=30

# Pagos con tarjeta (Culqi). Sin las dos llaves el formulario se ve pero no se puede pagar.
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=

# Modo simulaciÃ³n: tarjetas y QR de prueba sin cobrar, y nota de venta/ERP/boleta/correo simulados.
# Solo para desarrollo; en producciÃ³n (APP_ENV=production) se ignora.
PAYMENTS_SIMULATE=false
PAYMENTS_QR_MINUTES=10

# Yape con QR de Ligo Pay (pendiente de su API; dejar en false hasta integrarlo).
LIGO_PAY_ENABLED=false
LIGO_PAY_BASE_URL=
LIGO_PAY_CLIENT_ID=
LIGO_PAY_CLIENT_SECRET=


JWT_SECRET=change-me-to-a-random-32-character-minimum-secret
JWT_ISSUER="${APP_URL}"
JWT_TTL=60
JWT_COOKIE=overshark_admin_token
JWT_SECURE_COOKIE=true

